window-rule {
    match app-id="kitty"
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id="(?i)wechat"
    open-focused false
}

window-rule {
    match app-id="virt-manager"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.5; }
}

// 文件管理器
window-rule {
    match app-id="thunar"
    open-floating true
    background-effect {
        xray true
    }
}

window-rule {
    match app-id=r#"^thunar$"# title=r#"^Rename "#
    open-floating true
    max-width 350;
    max-height 150;
    default-floating-position x=0 y=650 relative-to="top"
}

window-rule {
    match title="Open Files"
    match title="Save As"
    match title="Select Move Destination"
    match title="Select Copy Destination"
    default-column-width { fixed 660; }
    default-window-height { fixed 830; }
}

window-rule {
    match title="Visual Studio Code"
    match title="Obsidian"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="gsr-notify"
    default-floating-position x=0 y=0 relative-to="top-left"
    open-focused false
}

window-rule {
    match app-id="polkit-gnome-authentication-agent-1"
    background-effect {
        blur false
        xray true
    }
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

layer-rule {
    match namespace="notifications"
    shadow {
        on
        softness 1
        spread -10
        offset x=7 y=22
        color "#bd5a6fCC"
        draw-behind-window true
    }
}

layer-rule {
    match namespace="^noctalia-wallpaper.*"
    match namespace="awww-daemon"
    place-within-backdrop true
}

window-rule {
    match app-id="dev.noctalia.Noctalia.Settings"
    opacity 1.0
}

layer-rule {
    match namespace="^noctalia-(panel|attached-panel)$"
    background-effect {
        blur true
        xray true
    }
}
