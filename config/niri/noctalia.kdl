layout {

    focus-ring {
        active-color   "#ff8888"
        inactive-color "#121215"
        urgent-color   "#ff5555"
    }

    border {
        active-color   "#ff8888"
        inactive-color "#121215"
        urgent-color   "#ff5555"
    }

    shadow {
        color "#12121570"
    }

    tab-indicator {
        active-color   "#ff8888"
        inactive-color "#d40000"
        urgent-color   "#ff5555"
    }

    insert-hint {
        color "#ff888880"
    }
}

recent-windows {
    highlight {
        active-color "#ff8888"
        urgent-color "#ff5555"
    }
}
